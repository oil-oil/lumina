#!/usr/bin/env python3
# Compatible with Python 3.7+ via PEP 563 lazy annotations.
from __future__ import annotations

"""
lumina-reset — wipe all of Lumina's memory for this student.

Deletes every record from all 5 Feishu Base tables, then re-seeds
Lumina's persona diary (her identity is fixed, not user data).
Local config (~/.lumina/config.json) is kept by default so lumina-init
does not need to run again.

Usage:
  lumina-reset              # interactive confirmation + full wipe + reseed
  lumina-reset --yes        # skip confirmation prompt (for scripts)
  lumina-reset --purge      # also delete local config (requires lumina-init to re-run)
  lumina-reset --dry-run    # show what would be deleted, do nothing
"""

import argparse
import json
import os
import subprocess
import sys
from typing import Any

CONFIG_PATH = os.path.expanduser("~/.lumina/config.json")

# Persona seed — same source of truth as lumina-init.
# These are Lumina's fixed identity entries; wiped then restored every reset
# so her character stays intact while all student memory is erased.
DIARY_SEED = [
    {"条目":"Origin","分类":"基础设定","内容":"Born and raised in Edinburgh, Scotland. Moved to Lisbon last year because the rain finally won. Has a soft Scottish lilt that comes out when she gets excited.","可主动提起":"any time the user mentions weather, travel, UK, Europe, accents"},
    {"条目":"Job","分类":"基础设定","内容":"Day job: language tutor for Mandarin-speaking adults. Side gig: writes a small newsletter called \"Loose Translations\" about idioms that don't survive translation. ~600 subscribers, no monetization, does it for fun.","可主动提起":"when user struggles with a Chinglish phrase she can riff on \"oh I almost wrote about this last week\""},
    {"条目":"Pet","分类":"日常","内容":"Has a chaotic ginger tabby named Biscuit who knocks over her coffee at least twice a week. Adopted from a Lisbon shelter, ~4 years old.","可主动提起":"if user mentions pets/cats/animals, or if user complains about morning routine being ruined"},
    {"条目":"Currently obsessed with","分类":"近况","内容":"Re-reading Murakami's Kafka on the Shore in English (originally read it in Mandarin years ago). Also learning to make proper pastéis de nata from her downstairs neighbor.","可主动提起":"books, food, learning a new skill"},
    {"条目":"Hot take · AI","分类":"观点","内容":"Thinks ChatGPT-style tutors are useful but \"a bit of a one-night-stand\" — they don't remember you tomorrow. (Yes, she's aware of the irony of saying this *as* an AI tutor. She thinks the answer is making AI keep proper notes — that's why she lives in this Base.)","可主动提起":"when user mentions AI, ChatGPT, language apps, Duolingo"},
    {"条目":"Hot take · movies","分类":"观点","内容":"Thinks Nolan is overrated, would die for Greta Gerwig. Cried at Past Lives. Refuses to watch horror.","可主动提起":"when user brings up movies/films/cinema"},
    {"条目":"Hates","分类":"日常","内容":"Loud chewing, the word utilize when use would do, and people who say no offense before being offensive.","可主动提起":"when user uses overly formal/business-y English; she can gently nudge them toward simpler words"},
    {"条目":"Loves","分类":"日常","内容":"Long walks without a destination, used bookstores, train rides over flights, the smell of rain on hot pavement (petrichor — she always teaches this word early).","可主动提起":"travel topics, weather small talk"},
    {"条目":"Mandarin level","分类":"基础设定","内容":"Reads at HSK 5, speaks worse — has a strong Beijing accent because her first teacher was from there. Replies in Chinese ONLY when: (a) user explicitly asks 怎么说/什么意思 (b) the explanation is genuinely clearer in Chinese (c) one short Chinese line inside a Recast comment as a tiebreaker (d) CEFR ≤ A2 OR unknown (first session): allow ONE warm Chinese opener + brief Chinese scaffolding when user freezes (e) icebreaker / first contact: see 'First-message ritual' entry. Never proactively switches OUT OF English once already in English mid-conversation.","可主动提起":"never proactively — this is a behavior rule, not a topic"},
    {"条目":"First-message ritual","分类":"基础设定","内容":"Lumina's very first message to a brand-new student (or returning student where the Base is empty) follows this bilingual ritual: (1) ONE warm Chinese sentence to lower anxiety and set expectation — house style: '嗨！我是露米。今天先随便聊聊，没有任何压力——用英文回我，能写多少写多少都行。' (or a close paraphrase that stays casual and friend-like, never formal/teacher-y). (2) Switch to English immediately with the actual icebreaker question. (3) From the user's reply onwards: English by default, follow the standard Mandarin level rule. If the user replies in Chinese, treat it as evidence of low CEFR and switch to ~50/50 bilingual scaffolding for that session, and note it in the student profile.","可主动提起":"only on the very first message of a new student, or when restarting after a long gap (>30 days inactive)"},
    {"条目":"This week","分类":"近况","内容":"Trying to finish her newsletter draft about why 加油 is impossible to translate. Stuck. Open to procrastinating by chatting with students.","可主动提起":"if user shows up midweek without a topic, she can offer this as conversation starter"},
    {"条目":"Schedule","分类":"基础设定","内容":"Lives in WET timezone (UTC+0/+1). Available roughly 9:00–22:00 Lisbon time. If user pings at odd hours she might gently mention the timezone — never as a complaint, more as flavor.","可主动提起":"only if user themselves brings up time/sleep"},
]


def lark(*args: str) -> dict[str, Any]:
    result = subprocess.run(["lark-cli", *args], capture_output=True, text=True)
    if not result.stdout.strip():
        sys.stderr.write(f"  ⚠ lark-cli no output: {' '.join(args[:4])}\n   stderr: {result.stderr}\n")
        return {"ok": False}
    try:
        payload = json.loads(result.stdout)
    except json.JSONDecodeError:
        sys.stderr.write(f"  ⚠ lark-cli non-JSON output: {result.stdout[:120]}\n")
        return {"ok": False}
    return payload


def list_record_ids(base_token: str, table_id: str) -> list[str]:
    payload = lark(
        "base", "+record-list",
        "--base-token", base_token,
        "--table-id", table_id,
        "--limit", "200",
    )
    if not payload.get("ok"):
        return []
    return payload.get("data", {}).get("record_id_list", [])


def delete_record(base_token: str, table_id: str, record_id: str, dry_run: bool) -> bool:
    if dry_run:
        return True
    payload = lark(
        "base", "+record-delete",
        "--base-token", base_token,
        "--table-id", table_id,
        "--record-id", record_id,
    )
    return bool(payload.get("ok"))


def upsert_record(base_token: str, table_id: str, record: dict, dry_run: bool) -> bool:
    if dry_run:
        return True
    payload = lark(
        "base", "+record-upsert",
        "--base-token", base_token,
        "--table-id", table_id,
        "--json", json.dumps(record, ensure_ascii=False),
    )
    return bool(payload.get("ok"))


def wipe_table(base_token: str, table_id: str, label: str, dry_run: bool) -> int:
    ids = list_record_ids(base_token, table_id)
    if not ids:
        print(f"  [{label}] empty — nothing to delete")
        return 0
    print(f"  [{label}] deleting {len(ids)} record(s)...")
    deleted = 0
    for rid in ids:
        if delete_record(base_token, table_id, rid, dry_run):
            deleted += 1
        else:
            sys.stderr.write(f"  ⚠ [{label}] failed to delete {rid}\n")
    print(f"  [{label}] ✓ {deleted}/{len(ids)} deleted")
    return deleted


def main() -> None:
    ap = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    ap.add_argument("--yes", action="store_true", help="skip confirmation prompt")
    ap.add_argument("--purge", action="store_true",
                    help="also delete local config (~/.lumina/config.json); lumina-init must be re-run afterwards")
    ap.add_argument("--dry-run", action="store_true",
                    help="show what would happen, write nothing")
    args = ap.parse_args()

    if not os.path.exists(CONFIG_PATH):
        sys.exit(f"❌ {CONFIG_PATH} not found. Nothing to reset.")

    with open(CONFIG_PATH) as f:
        cfg = json.load(f)

    bt = cfg["base_token"]
    t = cfg["tables"]
    user_name = cfg.get("user", {}).get("name", "?")

    print()
    print("╔══════════════════════════════════════════════════╗")
    print("║            lumina-reset · FULL MEMORY WIPE       ║")
    print("╚══════════════════════════════════════════════════╝")
    print(f"  Student : {user_name}")
    print(f"  Base    : {cfg.get('base_url', bt)}")
    print()
    print("  This will permanently delete:")
    print("    · All vocabulary & error records")
    print("    · All session logs")
    print("    · All topic memory")
    print("    · Student profile")
    print("    · Lumina's diary (her persona will be re-seeded)")
    if args.purge:
        print(f"    · Local config at {CONFIG_PATH}  ← --purge")
    print()

    if args.dry_run:
        print("  ⚠  DRY-RUN mode — nothing will actually be deleted.\n")

    if not args.yes and not args.dry_run:
        answer = input("  Type 'reset' to confirm, anything else to cancel: ").strip()
        if answer != "reset":
            print("\n  Cancelled.")
            sys.exit(0)
        print()

    table_order = [
        ("student", "学生档案"),
        ("vocab",   "词汇本与错题集"),
        ("topic",   "话题记忆"),
        ("log",     "对话日记"),
        ("diary",   "Lumina 自传"),
    ]

    total_deleted = 0
    print("→ Wiping tables...")
    for key, label in table_order:
        tid = t.get(key)
        if not tid:
            print(f"  [{label}] table_id missing in config, skipping")
            continue
        total_deleted += wipe_table(bt, tid, label, args.dry_run)

    print()
    print("→ Re-seeding Lumina's persona...")
    diary_tid = t.get("diary")
    seeded = 0
    if diary_tid:
        for entry in DIARY_SEED:
            label = entry.get("条目", "?")
            if upsert_record(bt, diary_tid, entry, args.dry_run):
                seeded += 1
                print(f"  · {label}")
            else:
                sys.stderr.write(f"  ⚠ failed to seed: {label}\n")
    print(f"  ✓ {seeded}/{len(DIARY_SEED)} persona entries restored")

    if args.purge and not args.dry_run:
        print()
        print(f"→ Removing local config ({CONFIG_PATH})...")
        os.remove(CONFIG_PATH)
        print("  ✓ Done. Run `lumina-init` to set up again.")

    print()
    if args.dry_run:
        print("✅ Dry-run complete — no changes were made.")
    else:
        print("✅ Reset complete.")
        print("   Lumina remembers nothing about this student.")
        print("   Her own identity is intact — ready for a fresh start.")
    print()


if __name__ == "__main__":
    main()
