#!/usr/bin/env python3
# Compatible with Python 3.7+ via PEP 563 lazy annotations.
from __future__ import annotations

"""
lumina-init — bootstrap Lumina's Lark Base in one shot.

What it does (idempotent):
  1. Look up current user via lark-cli contact +get-user
  2. Create a fresh Base (or reuse one via --reuse-base)
  3. Build 5 tables with all fields, one-by-one (avoids the partial-write
     bug in `+table-create --fields`)
  4. Seed Lumina's persona diary (11 entries; skips any already present)
  5. Write ~/.lumina/config.json

Usage:
  lumina-init                            # fresh Base in user's drive root
  lumina-init --folder TOKEN             # fresh Base inside specific folder
  lumina-init --reuse-base TOKEN         # use existing Base, only fill gaps
  lumina-init --base-name "..."          # custom name
  lumina-init --force                    # overwrite existing config
  lumina-init --dry-run                  # show plan, do nothing
"""

import argparse
import json
import os
import subprocess
import sys
from typing import Any, Optional

CONFIG_PATH = os.path.expanduser("~/.lumina/config.json")
DEFAULT_BASE_NAME = "Lumina · 我的英语学习档案"

SCHEMA = {
    "student": {
        "name": "学生档案 v2",
        "fields": [
            ("用户", "text"),
            ("open_id", "text"),
            ("CEFR等级", "text"),
            ("学习目标", "text"),
            ("兴趣标签", "text"),
            ("累计学习天数", "number"),
            ("上次互动日期", "datetime"),
            ("备注", "text"),
        ],
    },
    "vocab": {
        "name": "词汇本与错题集",
        "fields": [
            ("原句/生词", "text"),
            ("地道表达", "text"),
            ("类型", "text"),
            ("首次出现日期", "datetime"),
            ("复习次数", "number"),
            ("下次复习日期", "datetime"),
            ("出处文档", "text"),
        ],
    },
    "topic": {
        "name": "话题记忆",
        "fields": [
            ("主题", "text"),
            ("分类", "text"),
            ("关键词", "text"),
            ("事实/上下文", "text"),
            ("Lumina 的视角", "text"),
            ("首次提及", "datetime"),
            ("最近提及", "datetime"),
            ("状态", "text"),
        ],
    },
    "log": {
        "name": "对话日记",
        "fields": [
